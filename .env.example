# Client configuration (INSTRUCTIONS §14). Copy to client/.env.local for local overrides;
# the deploy job sets these in CI. Only VITE_* variables reach the browser: never put secrets here.

# The build shown on the main menu (the deploy sets "<commit> · <date>").
VITE_BUILD=
# Where the main menu's "Send feedback" link points (a form, an issues page, an email link).
# Empty: no link.
VITE_FEEDBACK_URL=
