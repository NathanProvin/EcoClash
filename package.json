{
  "name": "ecoclash",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "py:sync": "uv sync --directory tools",
    "py:test": "uv run --directory tools pytest",
    "py:lint": "uv run --directory tools ruff check . && uv run --directory tools ruff format --check .",
    "proto": "uv run --directory tools python -m prototype.match",
    "client:dev": "npm run wasm:build && npm run dev -w client",
    "client:build": "npm run build -w client",
    "client:check": "npm run check -w client",
    "client:lint": "npm run lint -w client",
    "client:test": "npm run test -w client",
    "rs:test": "cargo test --workspace",
    "rs:lint": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings",
    "rs:wasm": "cargo build -p sim-core --target wasm32-unknown-unknown --release",
    "rs:fixture": "uv run --directory tools python -m prototype.fixture",
    "cli:check": "uv run --directory tools python -m prototype.cli_check",
    "wasm:build": "cargo build -q -p sim-wasm --target wasm32-unknown-unknown --release && wasm-bindgen target/wasm32-unknown-unknown/release/sim_wasm.wasm --out-dir sim-wasm/pkg --target web",
    "wasm:check": "node sim-wasm/node/check.mjs",
    "relay": "npm run start -w relay",
    "relay:test": "npm run -s wasm:build && npm run test -w relay",
    "relay:lint": "prettier --check relay --config client/.prettierrc"
  },
  "workspaces": [
    "client",
    "relay"
  ]
}
